  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM104-1-Dec104-10Action",
    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "fr",
        "@value": "approuve la proposition du président du Comité consultatif des unités (CCU) de lancer une campagne de sensibilisation concernant le nouvel SI et lui demande de contacter le KRISS, le LNE, le NIST, le NMIJ, le NPL et la PTB afin qu'ils nomment des experts en relations publiques qui participeront à un groupe de travail dédié."
      },
      {
        "@language": "en",
        "@value": "approved the proposal made by the CCU President to start an awareness campaign relating to the new SI and requested him to contact KRISS, LNE, NIST, NMIJ, NPL and PTB to ask them to nominate experts in public relations to take part in a working group."
      }
    ]
  },
