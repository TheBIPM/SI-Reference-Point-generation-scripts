  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM101-1-Dec101-24Action",
    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "fr",
        "@value": "approuve la modification proposée concernant la disposition 10.2 des SRI intitulée « Échelle des traitements », en vigueur à compter du 1^er^ janvier 2013."
      },
      {
        "@language": "en",
        "@value": "approved the modification to Regulation 10.2 of the RRI, entitled Salaries scale, effective 1 January 2013."
      }
    ]
  },
