    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "fr",
        "@value": "approuve la proposition d'appliquer de façon temporaire un plafond de 1 % à la révision annuelle du point pour les années 2013 à 2015."
      },
      {
