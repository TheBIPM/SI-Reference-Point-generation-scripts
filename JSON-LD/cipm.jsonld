  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM53-Decl1964Considering",
    "https://si-digital-framework.org/bodies#hasConsideringText": [
      {
        "@language": "fr",
        "@value": "*habilité* par la Résolution 5 de la Douzième Conférence générale des poids et mesures à désigner les étalons atomiques ou moléculaires de fréquence à employer temporairement pour les mesures physiques de temps,"
      },
      {
        "@language": "en",
        "@value": "*empowered* by Resolution 5 of the 12th Conférence Générale des Poids et Mesures to name atomic or molecular frequency standards for temporary use for time measurements in physics,"
      }
    ]
  },
