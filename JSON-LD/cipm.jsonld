  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM42-Res1948Action",
    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "fr",
        "@value": "Entre les trois termes (« degré centigrade », « degré centésimal », « degré Celsius ») proposés pour désigner le degré de température, le Comité international a choisi « degré Celsius » (PV, *21*, 88)."
      },
      {
        "@language": "en",
        "@value": "From three names (“degree centigrade”, “centesimal degree”, “degree Celsius”) proposed to denote the degree of temperature, the CIPM has chosen “degree Celsius” (PV, *21*, 88)."
      }
    ]
  },
