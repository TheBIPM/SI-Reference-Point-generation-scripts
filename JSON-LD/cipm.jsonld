  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM102-2-Dec102-37Action",
    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "fr",
        "@value": "autorise le directeur du BIPM à appliquer les normes IPSAS 28, IPSAS 29 et IPSAS 30 sur les instruments financiers pour les états financiers de 2013 de la Caisse de retraite et de prévoyance du BIPM."
      },
      {
        "@language": "en",
        "@value": "gave the BIPM Director the authority to implement IPSAS 28, IPSAS 29 and IPSAS 30 on financial instruments for the 2013 financial statements of the BIPM Pension and Provident Fund."
      }
    ]
  },
