  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM104-1-Dec104-15Action",
    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "fr",
        "@value": "demande au bureau du CIPM d'organiser une réunion avec les présidents des organisations régionales de métrologie et de lui présenter les conclusions de cette réunion."
      },
      {
        "@language": "en",
        "@value": "requested the CIPM bureau to convene a meeting with the Regional Metrology Organization Chairs and to report back."
      }
    ]
  },
