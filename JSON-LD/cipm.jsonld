  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM108-2-Dec108-24Action",
    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "fr",
        "@value": "décide de mettre fin au Groupe de travail du CIPM sur le terme « unité », ce dernier ayant mené avec succès les tâches qui lui ont été confiées."
      },
      {
        "@language": "en",
        "@value": "decided to close the CIPM Task Group on \"unit\" because it has successfully completed its tasks."
      }
    ]
  },
