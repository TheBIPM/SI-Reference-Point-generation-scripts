  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM104-2-Dec104-46Considering",
    "https://si-digital-framework.org/bodies#hasConsideringText": [
      {
        "@language": "fr",
        "@value": "examinera de nouveau la politique d'acception de membres et observateurs au sein des Comités consultatifs lors d'une réunion des présidents des Comités consultatifs qui se tiendra en juin 2016. Les décisions sur le statut de membre ou observateur présentées lors de la seconde partie de la 104^e^ session du CIPM (octobre 2015) ne seront prises qu'une fois cet examen achevé."
      }
    ]
  },
