  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM104-2-Dec104-29Action",
    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "fr",
        "@value": "approuve la proposition d'appliquer de façon temporaire un plafond de 1 % à la révision annuelle du point du BIPM pour les années 2016 à 2019."
      },
      {
        "@language": "en",
        "@value": "approved the proposal that the BIPM point be adjusted temporarily during the period 2016-2019 by a maximum of 1 % on an annual basis."
      }
    ]
  },
