  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM110-1-Dec110-9Considering",
    "https://si-digital-framework.org/bodies#hasConsideringText": [
      {
        "@language": "fr",
        "@value": "note la décision prise par correspondance le 30 avril 2021 afin que le CNRC (Canada) devienne membre du CCRI."
      },
      {
        "@language": "en",
        "@value": "noted the decision taken by correspondence on 30 April 2021 that NRC (Canada) should be a member of the CCRI."
