  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM105-Dec105-29Action",
    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "fr",
        "@value": "décide que tous les Comités consultatifs devront examiner la liste de leurs membres et observateurs afin de vérifier s'ils remplissent les critères établis dans le document CIPM-D-01."
