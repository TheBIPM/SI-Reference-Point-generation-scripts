  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM103-2-Dec103-27Action",
    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "fr",
        "@value": "confirme qu'il a approuvé les états financiers audités du BIPM et de la Caisse de retraite et de prévoyance du BIPM par correspondance en juin 2014 et réitère son approbation. Le CIPM donne quitus de sa gestion au directeur, au titre de l'exercice"
      },
      {
        "@language": "en",
        "@value": "confirmed its approval of the audited financial statements of the BIPM and of the BIPM Pension and Provident Fund which it has approved by correspondence in June 2014. The CIPM gave the BIPM Director quietus for the 2013 exercise."
      }
    ]
  },
