        "@language": "fr",
        "@value": "Décision CIPM/102-7 (2013)"
      },
      {
        "@language": "en",
        "@value": "Decision CIPM/102-7 (2013)"
      }
    ],
    "https://si-digital-framework.org/bodies#isOutcomeOf": [
      {
