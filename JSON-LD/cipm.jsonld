  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM104-1",
    "@type": [
      "https://si-digital-framework.org/bodies#Event"
    ],
    "http://www.w3.org/2004/02/skos/core#hiddenLabel": [
