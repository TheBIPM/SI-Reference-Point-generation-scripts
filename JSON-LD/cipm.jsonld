  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM109-Dec109-3Considering",
    "https://si-digital-framework.org/bodies#hasConsideringText": [
      {
        "@language": "en",
        "@value": "noted the decision taken by correspondence on 28 February 2020 that Prof. Neyezhmakov will represent the BIPM at the JCGM-WG2:VIM. Seventeen members had voted in favour and one had abstained."
