  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM81-Rec3",
    "@type": [
      "https://si-digital-framework.org/bodies#Recommendation"
    ],
    "http://www.w3.org/2004/02/skos/core#hiddenLabel": [
      {
        "@value": "CIPM81-Rec3"
      }
    ],
    "https://si-digital-framework.org/bodies#hasAction": [
      {
