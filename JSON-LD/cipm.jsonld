    "https://si-digital-framework.org/bodies#hasConsideringText": [
      {
        "@language": "fr",
        "@value": "prend note de la décision du Comité consultatif de thermométrie (CCT) de réorganiser ses groupes de travail et de la Recommandation T1 (2014) du CCT."
      },
