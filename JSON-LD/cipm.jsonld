  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM108-2-Dec108-39Action",
    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "fr",
        "@value": "convient de charger le président du CIPM et le directeur du BIPM de signer la Déclaration de coopération concernant le JCTLM."
      },
      {
        "@language": "en",
        "@value": "agreed that the CIPM President and the BIPM Director should conclude the revised Declaration of Cooperation for the JCTLM."
      }
    ]
  },
