  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM82-Rec3Action",
    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "fr",
        "@value": "_recommande_ que les agences spatiales étudient l'installation sur leurs satellites d'équipements permettant d'effectuer des comparaisons d'horloges utilisant des techniques par laser."
      },
      {
        "@language": "en",
        "@value": "_recommends_ that the space agencies consider the installation on their satellites of appropriate equipment for dock comparison by satellite laser techniques."
      }
    ]
  },
