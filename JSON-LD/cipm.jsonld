  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM103-1-Dec103-22Action",
    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "fr",
        "@value": "demande à S. Arlen et à T.J. Quinn de rédiger chacun une note sur la terminologie : ces documents seront transmis au CIPM et examinés par le bureau du CIPM lors de sa réunion de juin 2014. Le bureau du CIPM préparera une recommandation qui sera soumise au CIPM en novembre 2014."
      },
      {
        "@language": "en",
        "@value": "charged S. Arlen and T.J. Quinn to prepare notes on terminology to be forwarded to the CIPM and to be considered by the bureau at its meeting in June 2014. The CIPM bureau will prepare a recommendation to be submitted to the CIPM in November 2014."
      }
    ]
  },
