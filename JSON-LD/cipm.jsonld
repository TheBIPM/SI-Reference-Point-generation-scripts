  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM104-2-Dec104-30Action",
    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "fr",
        "@value": "approuve le budget proposé par le directeur du BIPM pour 2016 (document CIPM/2015-II-15), en notant que ce dernier fournira au Sous comité du CIPM sur les finances de plus amples détails sur les dépenses de personnel budgétées."
      },
      {
        "@language": "en",
        "@value": "approved the budget proposed by the Director for 2016 (CIPM/2015-II-15), noting that he will provide further details of budgeted staff costs to the CIPM Sub-Committee on Finance."
      }
    ]
  },
