  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM77-Rec3Considering",
    "https://si-digital-framework.org/bodies#hasConsideringText": [
      {
        "@language": "fr",
        "@value": "_agissant_ conformément aux instructions données dans la Résolution 7 de la 18^e^ Conférence générale des poids et mesures concernant la mise au point d'une nouvelle échelle internationale de température,"
      },
      {
        "@language": "en",
        "@value": "_acting_ in accordance with instructions given in Resolution 7 of the 18th Conférence Générale des Poids et Mesures concerning the preparation of the new international temperature scale,"
      }
    ]
  },
