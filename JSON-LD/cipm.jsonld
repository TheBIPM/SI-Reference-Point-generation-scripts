  },
  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM111-2-Dec111-7Action",
    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "fr",
        "@value": "décide que le budget pour 2023 doit être conforme au budget approuvé par la CGPM à sa 26^e^ réunion (2018) concernant les dépenses et intégrer une estimation actualisée des revenus approuvée par le Sous-comité sur les finances."
      },
      {
        "@language": "en",
        "@value": "decided that the budget for 2023 should follow the expenditure agreed by the CGPM at its 26th meeting (2018) with an updated estimate for the revenue agreed by the CIPM Sub-Committee on Finance."
      }
    ]
  },
