  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM112-1-Dec112-13Action",
    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "fr",
        "@value": "Compte tenu des synergies entre le Groupe de travail du CIPM sur les données et le Groupe spécifique du CIPM sur le cadre numérique du SI, le CIPM décide de mettre fin au Groupe de travail du CIPM sur les données et d’inclure ses membres au Groupe spécifique."
      }
    ]
  },
