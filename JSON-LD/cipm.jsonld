  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM107-Dec107-20Action",
    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "fr",
        "@value": "approuve une « liste recommandée » de candidats pour l'élection du CIPM et charge le secrétaire du CIPM de l'envoyer au président de la Commission pour l'élection du CIPM."
      },
