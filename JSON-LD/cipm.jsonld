  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM104-1-Dec104-23Action",
    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "fr",
        "@value": "charge le BIPM de contacter l'ensemble des directeurs des laboratoires nationaux de métrologie pour solliciter leurs contributions et leur participation à l'atelier sur l'examen du CIPM MRA qui se tiendra en octobre 2015."
      },
      {
        "@language": "en",
        "@value": "requested the BIPM to contact all the NMI Directors to invite contributions and their participation in the workshop on the CIPM MRA review planned for October 2015."
      }
    ]
  },
