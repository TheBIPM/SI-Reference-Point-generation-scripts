  {
    "@id": "https://si-digital-framework.org/bodies/CIPM#CIPM110-2-Dec110-20Action",
    "https://si-digital-framework.org/bodies#hasActionText": [
      {
        "@language": "en",
        "@value": "received the report from the CCU on the Core Metrological Terms and noted that consensus could not be reached on the matter of three definitions (quantity, quantity of value and unit). The CIPM requests the CIPM Task Group on the Digital SI (CIPM TG DSI) to review the “machine actionability” of the three definitions under discussion and to report to the meeting of the CIPM in March 2022."
      }
    ]
  },
