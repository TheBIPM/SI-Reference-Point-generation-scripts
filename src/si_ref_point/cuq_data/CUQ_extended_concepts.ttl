@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix schema: <https://schema.org/> .

@prefix si: <http://si-digital-framework.org/SI#> .
@prefix units: <http://si-digital-framework.org/SI/units/> .
@prefix quantities: <http://si-digital-framework.org/quantities/> .
@prefix prefixes: <http://si-digital-framework.org/SI/prefixes/> .


# properties

## for products + multiples
si:hasFactor a owl:ObjectProperty ;
    rdfs:label "has factor" .

si:hasUnitFactor a owl:ObjectProperty ;
    rdfs:subPropertyOf si:hasFactor ;
    rdfs:label "has unit factor" ;
    schema:domainIncludes si:MeasurementUnit ;
    schema:rangeIncludes si:MeasurementUnit .

si:hasQuantityFactor a owl:ObjectProperty ;
    rdfs:subPropertyOf si:hasFactor ;
    rdfs:label "has quantity factor" ;
    schema:domainIncludes si:QuantityKind ;
    schema:rangeIncludes si:QuantityKind .

si:hasNumericFactor a owl:DatatypeProperty ;
    rdfs:subPropertyOf si:hasFactor ;
    schema:domainIncludes si:MeasurementUnit ;
    rdfs:label "has numeric factor" .

si:hasLeftUnitFactor a owl:ObjectProperty ;
    rdfs:label "has left unit factor" ;
    rdfs:comment "preserve order of multiplication" ;
    rdfs:subPropertyOf si:hasUnitFactor .

si:hasRightUnitFactor a owl:ObjectProperty ;
    rdfs:label "has right unit factor" ;
    rdfs:comment "preserve order of multiplication" ;
    rdfs:subPropertyOf si:hasUnitFactor .

## for powers
si:hasBase a owl:ObjectProperty ;
    rdfs:label "has base" ;
    rdfs:comment "Base ^ NumericExponent" .

si:hasUnitBase a owl:ObjectProperty ;
    rdfs:subPropertyOf si:hasBase ;
    rdfs:label "has unit base" ;
    rdfs:comment "UnitBase ^ NumericExponent" .

si:hasNumericExponent a owl:DatatypeProperty ;
    rdfs:label "has numeric exponent" ;
    rdfs:comment "UnitBase ^ NumericExponent" .

si:hasQuantityBase a owl:ObjectProperty ;
    rdfs:subPropertyOf si:hasBase ;
    rdfs:label "has quantity base" ;
    rdfs:comment "QuantityBase ^ NumericExponent" .

## for prefixunits
si:hasPrefix a owl:ObjectProperty ;
    rdfs:label "has prefix" ;
    rdfs:comment "<Prefix> and <NonPrefixedUnit> form a <PrefixedUnit>" ;
    rdfs:domain si:PrefixedUnit ;
    rdfs:range si:SIPrefix .

si:hasNonPrefixedUnit a owl:ObjectProperty ;
    rdfs:label "has non prefixed unit" ;
    rdfs:comment "<Prefix> and <NonPrefixedUnit> form a <PrefixedUnit>" ;
    rdfs:domain si:PrefixedUnit ;
    schema:rangeIncludes si:MeasurementUnit . # to generic?

## for log-units (it is quantities, not units that are logarithmic)
#si:hasNumericBase a owl:DatatypeProperty ;
#    rdfs:domain si:LogarithmicUnit ;
#    rdfs:comment "log_<NumericBase>(X / <RatioDenominator>); X is the actual quantity value" ;
#    rdfs:label "has log base" .
#
#si:hasRatioDenominator a owl:ObjectProperty ;
#    rdfs:domain si:LogarithmicUnit ;
#    rdfs:comment "log_<NumericBase>(X / <RatioDenominator>)" ;
#    rdfs:label "has ratio denominator" .

# compound quantities

si:CompoundQuantityKind a owl:Class ;  # DerivedQuantity?
    rdfs:label "compound quantitykind" ; 
    rdfs:subClassOf si:QuantityKind .

si:QuantityKindProduct a owl:Class ;
    rdfs:label "quantitykind product" ;
    rdfs:subClassOf si:CompoundQuantityKind .

si:QuantityKindPower a owl:Class ;
    rdfs:label "quantitykind power" ;
    rdfs:subClassOf si:CompoundQuantityKind .


# compound units

si:CompoundUnit a owl:Class ;
    rdfs:label "compound unit" ;  
    rdfs:subClassOf si:MeasurementUnit .

si:UnitMultiple a owl:Class ;
    rdfs:label "unit product" ;
    rdfs:subClassOf si:CompoundUnit .

si:UnitProduct a owl:Class ;
    rdfs:label "unit product" ;
    rdfs:subClassOf si:CompoundUnit .

si:UnitPower a owl:Class ;
    rdfs:label "unit power" ;
    rdfs:subClassOf si:CompoundUnit .

si:PrefixedUnit a owl:Class ;
    rdfs:label "prefixed unit" ;
    rdfs:subClassOf si:CompoundUnit .

#si:LogarithmicUnit a owl:Class ;
#    rdfs:label "unit power" ;
#    rdfs:subClassOf si:MeasurementUnit .

