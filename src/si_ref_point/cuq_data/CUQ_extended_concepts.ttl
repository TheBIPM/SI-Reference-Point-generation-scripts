@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix math: <http://cll.niimm.ksu.ru/ontologies/mathematics#> .

@prefix si: <http://si-digital-framework.org/SI#> .
@prefix units: <http://si-digital-framework.org/SI/units/> .
@prefix quantities: <http://si-digital-framework.org/quantities/> .
@prefix prefixes: <http://si-digital-framework.org/SI/prefixes/> .


# define some (abstract) mathematical operations

## Operation
si:Operation a owl:Class ;
    rdfs:label "Operation" ;
    rdfs:comment "Operation that is applied to operands" ;
    rdfs:seeAlso math:E1301 .

si:hasOperand a owl:ObjectProperty ;
    rdfs:label "has operand" ;
    rdfs:domain si:Operation .

## Multiplication
si:Multiplication a si:Operation ;
    rdfs:label "multiplication" ;
    rdfs:seeAlso math:E1318 .

si:hasFactor a owl:ObjectProperty ;
    rdfs:label "has factor" ;
    rdfs:subPropertyOf si:hasOperand ;
    rdfs:subPropertyOf si:includesUseOf ;
    rdfs:domain si:Multiplication .

## Exponentiation
si:Exponentiation a si:Operation ;
    rdfs:label "multiplication" ;
    rdfs:seeAlso math:E1302 .

si:hasBase a owl:ObjectProperty ;
    rdfs:label "has base" ;
    rdfs:subPropertyOf si:hasOperand ;
    rdfs:subPropertyOf si:includesUseOf ;
    rdfs:domain si:Exponentiation .

si:hasExponent a owl:ObjectProperty ;
    rdfs:label "has exponent" ;
    rdfs:subPropertyOf si:hasOperand ;
    rdfs:domain si:Exponentiation ;
    rdfs:range [owl:oneOf (xsd:double xsd:integer xsd:decimal)] .


# compound quantities

si:CompoundQuantityKind a owl:Class ;  # DerivedQuantity?
    rdfs:label "compound quantitykind" ; 
    rdfs:subClassOf si:QuantityKind .

si:QuantityKindProduct a owl:Class ;
    rdfs:label "quantitykind product" ;
    rdfs:subClassOf si:CompoundQuantityKind ;
    owl:equivalentClass [
        owl:intersectionOf (
            si:Multiplication
            [
                a owl:Restriction; 
                owl:onProperty si:hasFactor ;
                owl:someValuesFrom si:QuantityKind ;
                # allValuesFrom, owl:minCardinality 2 # not supported in OWL2 RL
            ] 
        )
    ].

si:QuantityKindPower a owl:Class ;
    rdfs:label "quantitykind power" ;
    rdfs:subClassOf si:CompoundQuantityKind ;
    owl:equivalentClass [
        owl:intersectionOf (
            si:Exponentiation
            [
                a owl:Restriction; 
                owl:onProperty si:hasBase ;
                owl:someValuesFrom si:QuantityKind ;
                # allValuesFrom, owl:minCardinality 1 # not supported in OWL2 RL
            ]
            [
                a owl:Restriction; 
                owl:onProperty si:hasExponent ;
                owl:someValuesFrom owl:Thing ;
                # allValuesFrom, owl:minCardinality 1 # not supported in OWL2 RL
            ]
        )
    ].


# compound units

si:CompoundUnit a owl:Class ;
    rdfs:label "compound unit" ;  
    rdfs:subClassOf si:MeasurementUnit .

si:UnitProduct a owl:Class ;
    rdfs:label "unit product" ;
    rdfs:subClassOf si:CompoundUnit ;
    owl:equivalentClass [
        owl:intersectionOf (
            si:Multiplication
            [
                a owl:Restriction; 
                owl:onProperty si:hasFactor ;
                owl:someValuesFrom si:MeasurementUnit; # allValuesFrom?
                # allValuesFrom, owl:minCardinality 2 # not supported in OWL2 RL
            ] 
        )
    ].

si:UnitPower a owl:Class ;
    rdfs:label "unit power" ;
    rdfs:subClassOf si:CompoundUnit ;
    owl:equivalentClass [
        owl:intersectionOf (
            si:Exponentiation
            [
                a owl:Restriction; 
                owl:onProperty si:hasBase ;
                owl:someValuesFrom si:MeasurementUnit ;
                # allValuesFrom, owl:minCardinality 1 # not supported in OWL2 RL
            ]
            [
                a owl:Restriction; 
                owl:onProperty si:hasExponent ;
                owl:someValuesFrom owl:Thing ;
                # allValuesFrom, owl:minCardinality 1 # not supported in OWL2 RL
            ]
        )
    ].


# prefixed unit

si:BasePrefixes a owl:Class ;
    rdfs:subClassOf si:SIPrefix ;
    owl:oneOf (
        prefixes:atto
        prefixes:centi
        prefixes:deca
        prefixes:deci
        prefixes:exa
        prefixes:femto
        prefixes:giga
        prefixes:hecto
        prefixes:kilo
        prefixes:mega
        prefixes:micro
        prefixes:milli
        prefixes:nano
        prefixes:peta
        prefixes:pico
        prefixes:quecto
        prefixes:quetta
        prefixes:ronna
        prefixes:ronto
        prefixes:tera
        prefixes:uetta
        prefixes:yocto
        prefixes:yotta
        prefixes:zepto
    ) .

si:hasPrefix a owl:ObjectProperty ;
    rdfs:label "has prefix" ;
    rdfs:domain si:MeasurementUnit ;
    rdfs:range si:SIPrefix .

si:hasBaseUnit a owl:ObjectProperty ;
    rdfs:label "has base unit" ;
    rdfs:domain si:MeasurementUnit .
    #rdfs:range si:NonPrefixedUnit .

si:PrefixedUnit a owl:Class ;
    rdfs:label "prefixed unit" ;
    rdfs:subClassOf si:MeasurementUnit ;
    owl:equivalentClass [
        owl:intersectionOf (
            [
                a owl:Restriction; 
                owl:onProperty si:hasPrefix ;
                owl:someValuesFrom si:BasePrefixes
            ]
            [
                a owl:Restriction; 
                owl:onProperty si:hasBaseUnit ;
                owl:someValuesFrom si:MeasurementUnit  # actually, we only want non-prefixed units here
            ]
        )
    ] .


