@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix math: <http://cll.niimm.ksu.ru/ontologies/mathematics#> .

@prefix ops: <http://si-digital-framework.org/operations/> .


# define some (abstract) mathematical operations

## Operation
ops:Operation a owl:Class ;
    rdfs:label "Operation" ;
    rdfs:comment "Operation that is applied to operands" ;
    rdfs:seeAlso math:E1301 .

ops:hasOperand a owl:ObjectProperty ;
    rdfs:label "has operand" ;
    rdfs:domain ops:Operation .

## Multiplication
ops:Multiplication a ops:Operation ;
    rdfs:label "multiplication" ;
    rdfs:seeAlso math:E1318 .

ops:hasFactor a owl:ObjectProperty ;
    rdfs:label "has factor" ;
    rdfs:subPropertyOf ops:hasOperand ;
    rdfs:domain ops:Multiplication .

ops:hasFactorA a owl:ObjectProperty ;
    rdfs:label "has factor A" ;
    rdfs:subPropertyOf ops:hasFactor .

ops:hasFactorB a owl:ObjectProperty ;
    rdfs:label "has factor B" ;
    rdfs:subPropertyOf ops:hasFactor .

## Exponentiation
ops:Exponentiation a ops:Operation ;
    rdfs:label "multiplication" ;
    rdfs:seeAlso math:E1302 .

ops:hasBase a owl:ObjectProperty ;
    rdfs:label "has base" ;
    rdfs:subPropertyOf ops:hasOperand ;
    rdfs:domain ops:Exponentiation .

ops:hasExponent a owl:ObjectProperty ;
    rdfs:label "has exponent" ;
    rdfs:subPropertyOf ops:hasOperand ;
    rdfs:domain ops:Exponentiation ;
    rdfs:range [owl:oneOf (xsd:double xsd:integer xsd:decimal)] .

# logarithm operation
ops:Logarithm a ops:Operation ;
    rdfs:label "logarithm" ;
    rdfs:seeAlso math:E1308 .

ops:hasLogBase a owl:ObjectProperty ;
    rdfs:label "has logarithm base" ;
    rdfs:subPropertyOf ops:hasOperand ;
    rdfs:domain ops:Logarithm ;
    rdfs:range [owl:oneOf (xsd:double xsd:integer xsd:decimal)] .

ops:hasLogArgument a owl:ObjectProperty ;
    rdfs:label "has logarithm argument" ;
    rdfs:subPropertyOf ops:hasOperand ;
    rdfs:domain ops:Logarithm .
